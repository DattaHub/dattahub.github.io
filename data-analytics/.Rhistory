# Plot the sample means as a function of the sample size
plot(sample_sizes, normal_means, type = "l", col = "blue", lwd = 2,
xlab = "Sample Size (n)", ylab = "Sample Mean",
main = "Sample Means from Normal Distribution")
# Add horizontal line at 0 for reference
abline(h = 0, col = "red", lwd = 2, lty = 2)
# Set random seed for reproducibility
set.seed(123)
# Define the range of sample sizes
sample_sizes <- seq(10, 500, by = 10)
# Initialize a vector to store the sample means
cauchy_means <- numeric(length(sample_sizes))
# Loop over the sample sizes
for (i in seq_along(sample_sizes)) {
n <- sample_sizes[i]
# Generate n random samples from the Cauchy distribution
samples <- rcauchy(n, location = 0, scale = 1)
# Calculate the sample mean
cauchy_means[i] <- mean(samples)
}
# Plot the sample means as a function of the sample size
plot(sample_sizes, cauchy_means, type = "l", col = "blue", lwd = 2,
xlab = "Sample Size (n)", ylab = "Sample Mean",
main = "Sample Means from Cauchy Distribution")
# Add horizontal line at 0 for reference
abline(h = 0, col = "red", lwd = 2, lty = 2)
