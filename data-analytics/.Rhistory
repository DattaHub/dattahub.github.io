```r
s1 <- sd(x);  s2 <- sd(y)
m  <- length(x);  n  <- length(y)
# Pooled SD
spooled <- sqrt(((m-1)*s1^2 + (n-1)*s2^2)) / sqrt(m+n-2)
# t-statistic
tval <- (mean(x) - mean(y)) / (spooled * sqrt(1/m + 1/n))
tval
# p-value (one-sided)
1 - pt(tval, df = m+n-2)
x <- birth$weight[birth$habit == "nonsmoker"]
y <- birth$weight[birth$habit == "smoker"]
t.test(x, y, alternative = "greater", var.equal = TRUE)
s1 <- sd(x);  s2 <- sd(y)
m  <- length(x);  n  <- length(y)
# Pooled SD
spooled <- sqrt(((m-1)*s1^2 + (n-1)*s2^2)) / sqrt(m+n-2)
# t-statistic
tval <- (mean(x) - mean(y)) / (spooled * sqrt(1/m + 1/n))
tval
# p-value (one-sided)
1 - pt(tval, df = m+n-2)
t.test(x, y, alternative = "greater", var.equal = FALSE)
x <- c(12.6, 11.2, 11.4,  9.4, 13.2, 12.0)   # before lunch
y <- c(16.4, 15.4, 14.1, 14.0, 13.4, 11.3)   # after  lunch
wilcox.test(x, y, paired = FALSE, alternative = "less")
# x before y  → alternative = "less"
wilcox.test(x, y, alternative = "less")
# y before x  → alternative = "greater"
wilcox.test(y, x, alternative = "greater")
U_Y  <- wilcox.test(y, x, alternative = "greater")$statistic
m    <- length(y);  n <- length(x)
mu_U <- m*n/2
s2_U <- m*n*(m+n+1)/12
# With continuity correction
Z <- (U_Y - mu_U - 0.5) / sqrt(s2_U)
Z
1 - pnorm(Z)
x <- c(12.6, 11.2, 11.4,  9.4, 13.2, 12.0)
y <- c(16.4, 15.4, 14.1, 14.0, 13.4, 11.3)
# Combine and rank
combined <- c(x, y)
grp      <- c(rep("x", length(x)), rep("y", length(y)))
rnks     <- rank(combined)
# t-test on the ranks
t.test(rnks[grp == "x"], rnks[grp == "y"],
alternative = "less", var.equal = TRUE)
# Wilcoxon rank-sum (exact)
wilcox.test(x, y, alternative = "less")
# t-test on ranks (normal approximation)
t.test(rank(c(x,y))[1:6], rank(c(x,y))[7:12],
alternative = "less", var.equal = TRUE)
x <- birth$weight[birth$habit == "nonsmoker"]
y <- birth$weight[birth$habit == "smoker"]
# 1. Two-sample t-test (raw data)
t.test(x, y, alternative = "greater")$p.value
# 2. Wilcoxon rank-sum
wilcox.test(x, y, alternative = "greater")$p.value
# 3. t-test on ranks
rnks <- rank(c(x, y))
nx   <- length(x)
t.test(rnks[1:nx], rnks[-(1:nx)],
alternative = "greater")$p.value
x <- c(12.6, 11.2, 11.4,  9.4, 13.2, 12.0)
y <- c(16.4, 15.4, 14.1, 14.0, 13.4, 11.0)
# HL estimate of Delta: median of all pairwise differences
pwd <- outer(x, y, "-")
median(pwd)
# HL estimate of median of X: median of Walsh averages
walsh_x <- outer(x, x, "+") / 2
walsh_x <- walsh_x[!lower.tri(walsh_x)]
median(walsh_x)
# Compare to sample median
median(x)
var.test(x, y)
